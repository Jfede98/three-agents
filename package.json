{
  "name": "three-agents",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "next build",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "next dev --port 3000",
    "dev:backend": "node scripts/dev-local.mjs backend",
    "setup": "node scripts/dev-local.mjs setup",
    "test:smoke": "node --env-file=.env.local scripts/smoke-local.mjs",
    "data:generate": "node scripts/generate-ops-data.mjs",
    "data:import": "node scripts/import-ops-data.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "convex": "^1.46.0",
    "lucide-react": "^1.53.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "convex-test": "^0.0.60",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}

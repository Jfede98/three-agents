# Referencia: no es necesario copiar este archivo para el desarrollo local.
# npm run setup configura Convex y escribe .env.local automáticamente.
# La URL y el nombre reales pueden variar según los puertos disponibles.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# CONVEX_DEPLOYMENT lo administra la CLI; no inventar ni copiar un nombre ajeno.
# .env.local y .convex/ contienen configuración local y nunca se suben a Git.

# Copiar a .env.local y completar con el despliegue AWS del equipo.
# Frontend público: origen HTTPS de CloudFront, SIN el sufijo /api.
NEXT_PUBLIC_CONVEX_URL=

# Solo CLI administrativa del backend self-hosted; no requiere Convex Cloud.
# Usar el mismo origen HTTPS que NEXT_PUBLIC_CONVEX_URL.
CONVEX_SELF_HOSTED_URL=
# Obtener mediante: docker compose exec -T backend ./generate_admin_key.sh
# NUNCA añadir NEXT_PUBLIC_ a esta clave ni publicarla en Git.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Variables de las acciones remotas: configurarlas con la CLI, no solo aquí.
# npx convex env set BEDROCK_USE_INSTANCE_ROLE true
# npx convex env set AWS_REGION us-east-1
# npx convex env set BEDROCK_MODEL_ID amazon.nova-lite-v1:0
# El backend EC2 utiliza su rol IAM para renovar credenciales automáticamente.

# Operador AWS: crear APARTE .env.aws.local (ignorado por Git).
# Copiar allí el bloque completo vigente del workshop:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# Estas credenciales sirven para scripts/deploy-aws.mjs; no son del frontend.

# Servidor Docker: /opt/farmaenlace/.env, separado de los archivos anteriores.
# PUBLIC_ORIGIN=<origen HTTPS de CloudFront>
# INSTANCE_NAME=farmaenlace-demo
# INSTANCE_SECRET=<secreto persistente generado en el servidor>
